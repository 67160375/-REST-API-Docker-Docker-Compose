# สำหรับรันแบบไม่ใช้ Docker (uvicorn ในเครื่อง) — คัดลอกเป็น backend/.env

# ---- ฐานข้อมูล (ค่านี้ตรงกับ docker-compose.yml) ----
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb

# ---- JWT: สุ่มใหม่ด้วยคำสั่ง  openssl rand -hex 32  (ยาวอย่างน้อย 32 ตัว) ----
SECRET_KEY=change_me_to_a_random_string_at_least_32_chars

# ---- พร้อมเพย์ของร้าน (ใช้สร้าง QR ที่ฝังยอดเงิน) ----
# เบอร์มือถือ 10 หลัก เช่น 0812345678 / เลขบัตรประชาชน 13 หลัก / e-Wallet 15 หลัก
PROMPTPAY_ID=
# ชื่อบัญชีที่ลูกค้าจะเห็นตอนจ่าย (ควรตรงกับชื่อที่แอปธนาคารแสดง) เช่น ภูวิศ พ.
PROMPTPAY_NAME=

# ---- เวลาล็อกที่นั่ง (นาที) ----
HOLD_MINUTES=10
REUPLOAD_MINUTES=30

# ---- ตรวจสลิปอัตโนมัติ (ไม่บังคับ) ----
# none = แอดมินตรวจเองทั้งหมด / easyslip = ส่งไปตรวจที่ EasySlip ก่อน ไม่ผ่านค่อยเข้าคิวแอดมิน
SLIP_VERIFY_PROVIDER=none
SLIP_VERIFY_API_KEY=
# คำบางส่วนของชื่อหรือเลขบัญชีผู้รับ ที่ต้องเจอในผลตรวจ (เว้นว่าง = ไม่เช็กผู้รับ)
SLIP_RECEIVER_HINT=
